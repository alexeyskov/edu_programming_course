# Generate with: openssl rand -hex 32
RUNNER_SHARED_SECRET=replace-with-at-least-32-random-bytes
RUNNER_EXECUTOR=local
RUNNER_WORK_ROOT=/tmp/edu-programming-runner
RUNNER_MAX_CONCURRENT_JOBS=2
RUNNER_QUEUE_WAIT_SECONDS=0.25
RUNNER_INTERACTIVE_WALL_SECONDS=60
RUNNER_INTERACTIVE_TERMINAL_TTL_SECONDS=300
RUNNER_REQUEST_BODY_LIMIT_BYTES=4194304
RUNNER_SIGNATURE_CLOCK_SKEW_SECONDS=60
RUNNER_NONCE_TTL_SECONDS=300
