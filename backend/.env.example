APP_SECRET_KEY=replace-with-at-least-32-random-characters
APP_DEBUG=0
ALLOWED_HOSTS=course.example.edu,backend
CORS_ALLOWED_ORIGINS=https://course.example.edu
PUBLIC_BASE_URL=https://course.example.edu
FRONTEND_URL=https://course.example.edu
MOODLE_CREDENTIAL_LOGIN_ALLOW_INSECURE_HTTP=0

DATABASE_URL=postgresql://course:change-me@postgres:5432/course
DB_SSLMODE=prefer
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=43200
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=0
FORWARDED_ALLOW_IPS=127.0.0.1

# Generate with: python -m app.cli hash-admin-token
ADMIN_TOKEN_HASH=
# Plain ADMIN_TOKEN is rejected unless APP_DEBUG=true.
ADMIN_TOKEN=
ADMIN_ELEVATION_IDLE_SECONDS=1800
ADMIN_ELEVATION_ABSOLUTE_SECONDS=7200

DEV_AUTH_ENABLED=0
MOODLE_MOCK_ENABLED=0
# Moodle connection. The normal pluginless transport talks to an isolated
# Playwright service; the optional bridge token remains available separately.
MOODLE_BASE_URL=https://edu.example.edu
MOODLE_SERVICE_TOKEN=
MOODLE_LAUNCH_SHARED_SECRET=
MOODLE_CREDENTIAL_ENCRYPTION_KEY=replace-with-at-least-64-random-hex-characters
MOODLE_HTTP_TIMEOUT_SECONDS=15
# Reserve before a confirmed live Quiz deadline; 900 - 300 = 600 editing seconds.
# 0 disables the reserve; untimed work is unchanged. Not an HTTP timeout.
MOODLE_SYNC_TIMEOUT=300
MOODLE_MAX_RESPONSE_BYTES=4194304
MOODLE_LOGIN_RATE_LIMIT_ATTEMPTS=8
MOODLE_LOGIN_NETWORK_RATE_LIMIT_ATTEMPTS=256
MOODLE_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
MOODLE_MAX_CONCURRENT_LOGINS_PER_WORKER=2
MOODLE_BROWSER_SERVICE_URL=http://moodle-browser:8083
MOODLE_BROWSER_SHARED_SECRET=
MOODLE_BROWSER_HTTP_TIMEOUT_SECONDS=300
MOODLE_BROWSER_REQUEST_BODY_MAX_BYTES=6291456
MOODLE_BROWSER_MAX_RESPONSE_BYTES=4194304
MOODLE_BROWSER_STORAGE_STATE_MAX_BYTES=262144

DEADLINE_POLL_SECONDS=5
LMS_CHECKPOINT_MAX_BYTES=4194304
LMS_CHECKPOINT_MAX_FILES=128
LMS_SYNC_RECEIPT_MAX_BYTES=65536
LMS_SYNC_COURSE_INTERVAL_SECONDS=900
LMS_SYNC_MAX_ATTEMPTS=8
LMS_SYNC_RETRY_BASE_SECONDS=15
LMS_SYNC_RETRY_MAX_SECONDS=3600
LMS_SYNC_LOCK_TIMEOUT_SECONDS=300
LMS_SYNC_WORKER_POLL_SECONDS=2

RUNNER_URL=http://runner:8081
RUNNER_SHARED_SECRET=
RUNNER_HTTP_TIMEOUT_SECONDS=65
RUNNER_REQUEST_BODY_MAX_BYTES=4194304
RUNNER_RESPONSE_BODY_MAX_BYTES=8388608
RUNNER_MAX_OUTPUT_BYTES=1000000
RUNNER_MAX_CONCURRENT_RUNS_PER_USER=2
RUNNER_RATE_LIMIT_RUNS=30
RUNNER_RATE_LIMIT_WINDOW_SECONDS=60
RUNNER_RUNNING_STALE_SECONDS=120
RUNNER_MOCK_ENABLED=0
# Teacher-only official hidden-test reports are synchronous. Keep total below
# the edge proxy timeout (frontend Nginx: 75s) and stale at least total + 15s.
# The mock runner cannot produce official evidence.
EVIDENCE_CASE_TIMEOUT_SECONDS=8
EVIDENCE_TOTAL_TIMEOUT_SECONDS=50
EVIDENCE_CPU_SECONDS_PER_CASE=2
EVIDENCE_MAX_CONCURRENT_REPORTS_PER_TEACHER=1
EVIDENCE_RATE_LIMIT_REPORTS=5
EVIDENCE_RATE_LIMIT_WINDOW_SECONDS=300
EVIDENCE_RUNNING_STALE_SECONDS=120

# Runtime CPU/memory selected in /system/settings can only lower the immutable
# runner profile. This file does not enable a networked runner mode.

AI_ENABLED=0
AI_MOCK_ENABLED=0
# Standard OpenAI Chat Completions. This local example is for a host-run backend;
# for a remote Ollama/vLLM/SGLang server, set its reachable /v1 base URL instead.
LLM_API_ADDRESS=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=Maternion/minicpm5:2b-q4_K_M
# Empty = no thinking override; 0/1 require support from the server AND model.
LLM_THINKING=
AI_API_STYLE=chat_completions
AI_TIMEOUT_SECONDS=45
AI_MAX_RESPONSE_BYTES=1048576
AI_MAX_CONTEXT_BYTES=262144
AI_MAX_OUTPUT_CHARS=12000
AI_HISTORY_MESSAGES=20
# Per external principal and chat mode, summed across that user's threads.
AI_STUDENT_RATE_LIMIT_MESSAGES=10
AI_TEACHER_RATE_LIMIT_MESSAGES=30
AI_RATE_LIMIT_WINDOW_SECONDS=60

AUTHORSHIP_ANALYZER_URL=
AUTHORSHIP_ANALYZER_TOKEN=
AUTHORSHIP_ANALYZER_SHARED_SECRET=
AUTHORSHIP_ANALYZER_TIMEOUT_SECONDS=30
AUTHORSHIP_ALLOW_INSECURE_HTTP=0
AUTHORSHIP_PSEUDONYM_SECRET=
AUTHORSHIP_MAX_EXPORT_BYTES=16777216
AUTHORSHIP_MAX_RESPONSE_BYTES=1048576

PLAGIARISM_SHINGLE_SIZE=7
PLAGIARISM_WINNOW_WINDOW=5
PLAGIARISM_MIN_SCORE=0.30
PLAGIARISM_MAX_EVIDENCE=20
PLAGIARISM_MAX_SUBMISSIONS=300
PLAGIARISM_MAX_SUBMISSION_BYTES=2097152
PLAGIARISM_MAX_SCAN_BYTES=67108864

APP_BUILD=production
WEB_CONCURRENCY=2
WEB_TIMEOUT_SECONDS=90
AUTO_MIGRATE=false
